<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recipe Suggestions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/gray_800" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSuggestionsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Based on your selected ingredients"
        android:textSize="14sp"
        android:textColor="@color/gray_600"
        android:layout_marginBottom="16dp" />

    <!-- Filter chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAllMeals"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Meals"
            android:checked="true"
            app:chipBackgroundColor="@color/mint_green" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBreakfast"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Breakfast"
            app:chipBackgroundColor="@color/mint_green" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLunch"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunch"
            app:chipBackgroundColor="@color/mint_green" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDinner"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dinner"
            app:chipBackgroundColor="@color/mint_green" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSnacks"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snacks"
            app:chipBackgroundColor="@color/mint_green" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Recipe suggestions RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipeSuggestions"
        android:layout_width="match_parent"
        android:layout_height="400dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_recipe"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No recipe suggestions found"
            android:textSize="16sp"
            android:textColor="@color/gray_600"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try selecting more ingredients"
            android:textSize="14sp"
            android:textColor="@color/gray_500"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
