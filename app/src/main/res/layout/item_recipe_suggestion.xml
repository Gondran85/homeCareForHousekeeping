<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Recipe Image -->
        <ImageView
            android:id="@+id/ivRecipeImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe_placeholder"
            android:background="@color/gray_200" />

        <!-- Recipe Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Recipe Name -->
            <TextView
                android:id="@+id/tvRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_800"
                android:layout_marginBottom="4dp" />

            <!-- Recipe Description -->
            <TextView
                android:id="@+id/tvRecipeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe description"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="12dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Recipe Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- Cooking Time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_time"
                        android:tint="@color/mint_green"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvCookingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 min"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600" />

                </LinearLayout>

                <!-- Difficulty -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_difficulty"
                        android:tint="@color/mint_green"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Easy"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600" />

                </LinearLayout>

                <!-- Matching Ingredients Count -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|end">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_ingredients"
                        android:tint="@color/mint_green"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvMatchingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/8"
                        android:textSize="12sp"
                        android:textColor="@color/mint_green"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Matching Ingredients -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matching ingredients:"
                android:textSize="12sp"
                android:textColor="@color/gray_600"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <!-- Chips will be added programmatically -->

            </com.google.android.material.chip.ChipGroup>

            <!-- Add to Plan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add to Meal Plan"
                android:backgroundTint="@color/mint_green"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
