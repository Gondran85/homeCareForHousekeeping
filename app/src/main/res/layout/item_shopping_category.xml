<?xml version="1.0" encoding="utf-8"?>
<!-- Layout reutilizável para cada categoria da lista de compras -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TaskCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho da categoria (clicável para expandir/colapsar) -->
        <LinearLayout
            android:id="@+id/layoutCategoryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <!-- Título da categoria com emoji -->
            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/gray_800"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="🥩 Proteínas" />

            <!-- Contador de itens selecionados na categoria -->
            <TextView
                android:id="@+id/tvCategoryProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_progress_badge"
                android:minWidth="40dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="center"
                tools:text="2/5" />

            <!-- Ícone de expansão/colapso -->
            <ImageView
                android:id="@+id/ivExpandCollapse"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/expand_collapse_category"
                app:srcCompat="@drawable/ic_expand_more"
                app:tint="@color/gray_600" />

        </LinearLayout>

        <!-- Container dos itens da categoria (inicialmente oculto) -->
        <LinearLayout
            android:id="@+id/layoutCategoryItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Os CheckBoxes dos itens serão adicionados aqui dinamicamente -->

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
